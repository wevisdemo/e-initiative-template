{
	"name": "e-initiative-template",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "concurrently npm:dev:*",
		"dev:functions": "pnpm --filter functions run build:watch",
		"dev:astro": "astro dev",
		"dev:firebase": "firebase emulators:start --import ./mocks/firebase/ --project default",
		"build": "astro build",
		"deploy:functions": "firebase deploy --only functions --project production",
		"preview": "astro preview",
		"emulator:save": "firebase emulators:export ./mocks/firebase/",
		"download:local": "NODE_ENV=development node --env-file=.env.development --import tsx ./src/scripts/downloader.ts",
		"download:prod": "node --env-file=.env.production --import tsx ./src/scripts/downloader.ts",
		"render": "node --import tsx ./src/scripts/renderer.ts",
		"render:watch": "node --watch --import tsx ./src/scripts/renderer.ts",
		"check": "astro check --minimumSeverity warning",
		"format": "prettier --write --ignore-unknown .",
		"prepare": "husky",
		"postinstall": "pnpm --filter functions run build"
	},
	"lint-staged": {
		"README.md": "doctoc --github",
		"*": "prettier --write --ignore-unknown"
	},
	"dependencies": {
		"@felte/reporter-svelte": "^1.2.0",
		"@pdf-lib/fontkit": "^1.1.1",
		"@sinclair/typebox": "^0.32.31",
		"d3-dsv": "^3.0.1",
		"dayjs": "^1.11.23",
		"doctoc": "^2.5.0",
		"felte": "^1.3.0",
		"firebase": "^10.12.2",
		"pdf-lib": "^1.17.1",
		"scrollama": "^3.2.0",
		"sheethuahua": "^4.0.1",
		"signature_pad": "^5.1.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/svelte": "^9.1.1",
		"@astrojs/tailwind": "^6.0.2",
		"@commitlint/cli": "^19.3.0",
		"@commitlint/config-conventional": "^19.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/d3-dsv": "^3.0.7",
		"arquero": "^5.4.0",
		"astro": "^7.4.2",
		"concurrently": "^8.2.2",
		"daisyui": "^3.9.4",
		"firebase-tools": "^15.34.1",
		"husky": "^9.1.7",
		"lint-staged": "^15.2.2",
		"prettier": "^3.2.5",
		"prettier-plugin-astro": "^0.13.0",
		"prettier-plugin-svelte": "^3.2.3",
		"prettier-plugin-tailwindcss": "^0.5.14",
		"svelte": "^5.57.3",
		"tailwindcss": "^3.4.3",
		"tsx": "^4.23.15",
		"typescript": "^5.4.5"
	}
}
